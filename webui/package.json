{
  "name": "reccmp-js-tests",
  "version": "1.0.0",
  "description": "This is only to run tests/linting, not for building.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "e2e": "playwright test",
    "e2e-ui": "playwright test --ui",
    "lint": "biome check e2e ../reccmp/assets/*.js ../reccmp/assets/components/*.js",
    "lint:fix": "biome check --write e2e ../reccmp/assets/*.js ../reccmp/assets/components/*.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "24.0.8",
    "typescript": "7.0.2"
  }
}
